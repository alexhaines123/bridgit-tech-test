# Copy to .env.local and fill in. Never commit real values.

# AI provider key supplied for the exercise (read by the Vercel AI SDK Anthropic provider).
ANTHROPIC_API_KEY=

# Model used for the briefing. Switchable without code changes.
AI_MODEL=

# Redis cache (matches docker-compose.yml; start it with `docker compose up -d`).
REDIS_URL=redis://localhost:6379
